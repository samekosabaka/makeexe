{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TIMEKEEP",
  "version": "2.1.0",
  "identifier": "com.iamhisu.timekeep",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TIMEKEEP",
        "width": 1200,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}